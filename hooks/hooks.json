{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command",
            "if": "Bash(git commit*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 20,
            "statusMessage": "Checking verification receipt..." },
          { "type": "command",
            "if": "Bash(git push*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 20,
            "statusMessage": "Checking verification receipt..." },
          { "type": "command",
            "if": "Bash(gh pr*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 20,
            "statusMessage": "Checking verification receipt..." },
          { "type": "command",
            "if": "Bash(git tag*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 20,
            "statusMessage": "Checking verification receipt..." },
          { "type": "command",
            "if": "Bash(npm publish*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 20,
            "statusMessage": "Checking verification receipt..." }
        ]
      }
    ]
  }
}
