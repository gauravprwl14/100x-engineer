{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 30,
            "statusMessage": "Checking verification receipt..."
          },
          {
            "type": "command",
            "if": "Bash(*gh *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 30,
            "statusMessage": "Checking verification receipt..."
          },
          {
            "type": "command",
            "if": "Bash(*npm *publish*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 30,
            "statusMessage": "Checking verification receipt..."
          },
          {
            "type": "command",
            "if": "Bash(*pnpm *publish*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 30,
            "statusMessage": "Checking verification receipt..."
          },
          {
            "type": "command",
            "if": "Bash(*yarn *publish*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 30,
            "statusMessage": "Checking verification receipt..."
          },
          {
            "type": "command",
            "if": "Bash(*twine *upload*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 30,
            "statusMessage": "Checking verification receipt..."
          },
          {
            "type": "command",
            "if": "Bash(*uv *publish*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_verification.py\"",
            "timeout": 30,
            "statusMessage": "Checking verification receipt..."
          }
        ]
      }
    ]
  }
}
