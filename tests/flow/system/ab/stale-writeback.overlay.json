{
 "system": {
  "title": "Who talks to whom when a note is read and saved",
  "caption": "Read the numbers in order: they are the journey. The red link is where the stale copy can appear.",
  "cols": 3,
  "items": [
   {
    "id": "people",
    "label": "People",
    "items": [
     {
      "id": "reader",
      "label": "Reader",
      "sub": "opens a note",
      "kind": "actor"
     },
     {
      "id": "editor",
      "label": "Editor",
      "sub": "saves a change",
      "kind": "actor"
     }
    ],
    "cols": 1
   },
   {
    "id": "service",
    "label": "Notes service",
    "items": [
     {
      "id": "routes",
      "label": "Routes",
      "sub": "one read and one save endpoint",
      "ev": [
       "e-route-get"
      ]
     },
     {
      "id": "notes",
      "label": "Notes module",
      "sub": "reads through the cache, saves then clears it",
      "ev": [
       "e-cache-get"
      ]
     }
    ],
    "cols": 1
   },
   {
    "id": "storage",
    "label": "Storage",
    "items": [
     {
      "id": "cache",
      "label": "Cache",
      "sub": "keeps a note for a while",
      "kind": "data",
      "ev": [
       "e-ttl"
      ]
     },
     {
      "id": "db",
      "label": "Database",
      "sub": "the source of truth",
      "kind": "data",
      "ev": [
       "e-db-read"
      ]
     }
    ],
    "cols": 1
   }
  ],
  "links": [
   {
    "from": "reader",
    "to": "routes",
    "label": "open a note",
    "style": "call",
    "n": 1,
    "ev": [
     "e-route-get"
    ]
   },
   {
    "from": "routes",
    "to": "notes",
    "label": "read",
    "style": "call",
    "n": 1,
    "ev": [
     "e-route-get"
    ]
   },
   {
    "from": "notes",
    "to": "cache",
    "label": "look up",
    "style": "data",
    "n": 2,
    "ev": [
     "e-cache-get"
    ]
   },
   {
    "from": "notes",
    "to": "db",
    "label": "read on a miss",
    "style": "data",
    "n": 3,
    "ev": [
     "e-db-read"
    ]
   },
   {
    "from": "notes",
    "to": "cache",
    "label": "fill, can go stale",
    "style": "risk",
    "n": 4,
    "ev": [
     "e-cache-set"
    ]
   },
   {
    "from": "editor",
    "to": "routes",
    "label": "save",
    "style": "call",
    "n": 5,
    "ev": [
     "e-route-patch"
    ]
   },
   {
    "from": "notes",
    "to": "db",
    "label": "write",
    "style": "data",
    "n": 5,
    "ev": [
     "e-db-write"
    ]
   },
   {
    "from": "notes",
    "to": "cache",
    "label": "delete the key",
    "style": "async",
    "n": 6,
    "ev": [
     "e-cache-del"
    ]
   }
  ],
  "journey": [
   {
    "title": "A reader opens a note",
    "scenario": "happy"
   },
   {
    "title": "The service looks in the cache first",
    "scenario": "happy"
   },
   {
    "title": "On a miss it reads the database",
    "scenario": "happy"
   },
   {
    "title": "It then fills the cache, which is where a stale copy can start",
    "scenario": "race"
   },
   {
    "title": "An editor saves a change",
    "scenario": "race"
   },
   {
    "title": "The save clears the cached copy",
    "scenario": "race"
   }
  ]
 }
}
