  "journey": [
   {
    "title": "The client starts a transaction",
    "why": "A client wants several databases to change together, so it asks one coordinator to run the change."
   },
   {
    "title": "The coordinator asks each participant to get ready",
    "why": "The coordinator asks every participant whether it can do its part, without doing it yet."
   },
   {
    "title": "Each participant votes",
    "why": "Each participant checks that it can, promises to keep the change ready, and answers yes or no."
   },
   {
    "title": "The coordinator writes down its decision",
    "why": "If everyone said yes, the coordinator writes the decision in a log first, so a crash cannot make it forget."
   },
   {
    "title": "It tells everyone to commit",
    "why": "Only then does it tell everyone to make the change real."
   },
   {
    "title": "A participant that is down blocks the rest",
    "why": "A participant that promised and then goes quiet leaves the others waiting, which is the weakness of the method."
   }
